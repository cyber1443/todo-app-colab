{"seq":39,"ts":1791813137375,"actorId":"6517ac29-3bf0-4e02-8ade-d34ac83ea082","body":{"type":"decomposition.proposed","decomposition":{"id":"8969beec-d18e-4f44-bb54-f586819fce5b","sessionId":"e54763f6-b6ad-43bc-97f1-174b7e1daddd","ticketId":"fd41224a-0547-4430-85af-26e144499e30","issueRef":null,"contract":{"summary":"Footer test: a dependency-free node:test spec that asserts a Footer component exists, renders the text 'session-share test', and is mounted in App below the main content.","files":[{"path":"tests/footer.test.mjs","purpose":"Acceptance spec for the footer task; runs with plain node, no extra deps","contents":"import { test } from 'node:test'\nimport assert from 'node:assert/strict'\nimport { readFileSync, existsSync } from 'node:fs'\n\nconst read = (p) => readFileSync(new URL(`../${p}`, import.meta.url), 'utf8')\n\ntest('Footer component renders the session-share text', () => {\n  assert.ok(existsSync(new URL('../src/Footer.jsx', import.meta.url)), 'src/Footer.jsx missing')\n  const src = read('src/Footer.jsx')\n  assert.match(src, /export default function Footer/)\n  assert.match(src, /<footer[\\s>]/)\n  assert.match(src, /session-share test/)\n})\n\ntest('App mounts Footer after the main content', () => {\n  const app = read('src/App.jsx')\n  assert.match(app, /import Footer from '\\.\\/Footer(\\.jsx)?'/)\n  const footerAt = app.indexOf('<Footer')\n  assert.ok(footerAt > app.indexOf('id=\"next-steps\"'), 'Footer must come after main content')\n})\n"}]},"tasks":[{"id":"footer-line","title":"Add 'session-share test' footer under main content","intent":"Create src/Footer.jsx (default export Footer rendering <footer>session-share test</footer>), import it in src/App.jsx and render it after the next-steps section. Optional minimal styling in src/App.css.","ownedPaths":["src/Footer.jsx","src/App.jsx","src/App.css"],"dependsOn":[],"assumes":[],"acceptance":{"testCommand":"node --test tests/footer.test.mjs","testFiles":["tests/footer.test.mjs"],"manualChecks":